function Test-ExpectThrow([scriptblock]$Body) {
    $thrown = $false
    try { & $Body } catch { $thrown = $true }
    Assert-That $thrown 'Expected an error, but the operation succeeded.'
}
function Test-Case([string]$Name, [scriptblock]$Body) {
    try { & $Body; $script:TestPassed++; Write-Host ('PASS ' + $Name) }
    catch { $script:TestFailed++; Write-Host ('FAIL ' + $Name + ': ' + $_.Exception.Message) }
}
function Invoke-SelfTests {
    $script:TestPassed = 0; $script:TestFailed = 0
    $target = [pscustomobject]@{
        window = [pscustomobject]@{ processName = 'demo'; className = ''; title = 'Demo'; titleMatch = 'Exact' }
        path = @([pscustomobject]@{ automationId = 'input'; name = ''; className = ''; controlType = 50004; useName = $false; index = 0; matchCount = 1 })
    }
    $document = New-Recording
    $document.variables = [pscustomobject]@{ Customer = 'Mira'; Empty = '' }
    $document.steps = @((New-Step 'SetValue' $target ([pscustomobject]@{ value = '${Customer}' })))
    Test-Case 'Empty recording and JSON array round trip' {
        $d = Copy-Data (New-Recording); Assert-Recording $d
        Assert-That ($d.steps -is [array] -and $d.steps.Count -eq 0) 'Empty array lost.'
    }
    Test-Case 'One-step recording and one-segment path round trip' {
        $d = Copy-Data $document; Assert-Recording $d
        Assert-That ($d.steps.Count -eq 1 -and $d.steps[0].target.path.Count -eq 1) 'Array changed.'
    }
    Test-Case 'Window-only target permits an empty path' {
        $d = Copy-Data $document; $d.steps[0].target.path = @(); Assert-Recording $d
    }
    Test-Case 'Reject unknown format' { $d = Copy-Data $document; $d.format = 'Other'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject unsupported schema version' { $d = Copy-Data $document; $d.schemaVersion = 2; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject boolean schema version' { $d = Copy-Data $document; $d.schemaVersion = $true; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject unknown top-level field' { $d = Copy-Data $document; $d | Add-Member NoteProperty script 'evil'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject missing required field' { $d = Copy-Data $document; $d.PSObject.Properties.Remove('settings'); Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject singleton object in place of steps array' { $d = Copy-Data $document; $d.steps = $d.steps[0]; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject duplicate step identity' { $d = Copy-Data $document; $d.steps += (Copy-Data $d.steps[0]); Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject executable action' { $d = Copy-Data $document; $d.steps[0].action = 'Invoke-Expression'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject unexpected step field' { $d = Copy-Data $document; $d.steps[0] | Add-Member NoteProperty code '1'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject string enabled flag' { $d = Copy-Data $document; $d.steps[0].enabled = 'false'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject zero timeout' { $d = Copy-Data $document; $d.steps[0].timeoutMs = 0; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject negative pacing' { $d = Copy-Data $document; $d.settings.intervalMs = -1; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject unsupported failure policy' { $d = Copy-Data $document; $d.steps[0].onError = 'Retry'; Test-ExpectThrow { Assert-Recording $d } }
    Test-Case 'Reject out-of-bounds locator index' { $t = Copy-Data $target; $t.path[0].index = 1; Test-ExpectThrow { Assert-Target $t } }
    Test-Case 'Reject missing locator path' { $t = Copy-Data $target; $t.PSObject.Properties.Remove('path'); Test-ExpectThrow { Assert-Target $t } }
    Test-Case 'Reject empty window process' { $t = Copy-Data $target; $t.window.processName = ''; Test-ExpectThrow { Assert-Target $t } }
    Test-Case 'Reject non-UIA control type' { $t = Copy-Data $target; $t.path[0].controlType = 42; Test-ExpectThrow { Assert-Target $t } }
    Test-Case 'Reject null action arguments' { $s = Copy-Data $document.steps[0]; $s.arguments = $null; Test-ExpectThrow { Assert-Step $s } }
    Test-Case 'Delay accepts zero milliseconds' { Assert-Step (New-Step 'Delay' $null ([pscustomobject]@{ milliseconds = 0 })) }
    Test-Case 'Reject Delay with a target' { Test-ExpectThrow { Assert-Step (New-Step 'Delay' $target ([pscustomobject]@{ milliseconds = 1 })) } }
    Test-Case 'Reject negative Delay' { Test-ExpectThrow { Assert-Step (New-Step 'Delay' $null ([pscustomobject]@{ milliseconds = -1 })) } }
    Test-Case 'Reject fractional Delay' { Test-ExpectThrow { Assert-Step (New-Step 'Delay' $null ([pscustomobject]@{ milliseconds = 0.5 })) } }
    Test-Case 'All action argument defaults have valid schemas' {
        foreach ($action in $script:Actions) {
            $t = $target; if ($action -eq 'Delay') { $t = $null }
            Assert-Step (New-Step $action $t (Get-DefaultArguments $action))
        }
    }
    Test-Case 'Reject arbitrary assertion property' {
        Test-ExpectThrow { Assert-Step (New-Step 'AssertProperty' $target ([pscustomobject]@{ property = 'Password'; operator = 'Equals'; expected = '' })) }
    }
    Test-Case 'Reject invalid scrolling enumeration' {
        Test-ExpectThrow { Assert-Step (New-Step 'Scroll' $target ([pscustomobject]@{ horizontal = 'Left'; vertical = 'NoAmount' })) }
    }
    Test-Case 'Reject fractional negative scroll percentage' {
        Test-ExpectThrow { Assert-Step (New-Step 'SetScrollPercent' $target ([pscustomobject]@{ horizontal = -0.5; vertical = 100 })) }
    }
    Test-Case 'Reject non-finite numeric value' { Test-ExpectThrow { Assert-Step (New-Step 'SetRange' $target ([pscustomobject]@{ value = 'NaN' })) } }
    Test-Case 'Variables replace multiple occurrences and preserve blanks' {
        $v = Get-Variables $document ''; $text = Expand-Data '${Customer}-${Customer}-${Empty}' $v
        Assert-That ($text -ceq 'Mira-Mira-') 'Incorrect expansion.'
    }
    Test-Case 'Missing variables fail before execution' { Test-ExpectThrow { Resolve-StepData $document.steps[0] @{} } }
    Test-Case 'Variable text is literal, never recursively evaluated' {
        $value = '$(throw 123); ${Other}; `n; $1'
        Assert-That ((Expand-Data '${X}' @{ X = $value }) -ceq $value) 'Variable was interpreted.'
    }
    Test-Case 'Variable expansion preserves path arrays and original source' {
        $s = Resolve-StepData $document.steps[0] @{ Customer = 'Changed' }
        Assert-That ($s.arguments.value -ceq 'Changed' -and $s.target.path -is [array]) 'Expansion failed.'
        Assert-That ($document.steps[0].arguments.value -ceq '${Customer}') 'Original mutated.'
    }
    Test-Case 'Expansion cannot rewrite the step action or identity' {
        $s = Copy-Data $document.steps[0]; $s.id = '${Customer}'; $s.label = '${Customer}'
        $expanded = Resolve-StepData $s @{ Customer = 'Changed' }
        Assert-That ($expanded.id -ceq '${Customer}' -and $expanded.action -ceq 'SetValue') 'Control fields expanded.'
    }
    Test-Case 'Expanded numeric parameters are range-validated' {
        $s = New-Step 'SetRange' $target ([pscustomobject]@{ value = '${Amount}' })
        Assert-That ((Resolve-StepData $s @{ Amount = '1.5' }).arguments.value -ceq '1.5') 'Numeric substitution failed.'
        Test-ExpectThrow { Resolve-StepData $s @{ Amount = 'NaN' } }
        Test-ExpectThrow { Resolve-StepData $s @{ Amount = '${Unresolved}' } }
    }
    Test-Case 'Reject malformed variable names and non-string values' {
        Test-ExpectThrow { Assert-Variables ([pscustomobject]@{ 'bad-name' = 'x' }) }
        Test-ExpectThrow { Assert-Variables ([pscustomobject]@{ Good = 123 }) }
    }
    Test-Case 'Assertions use literal case-sensitive comparison' {
        Assert-That (Test-Assertion 'abc*' ([pscustomobject]@{ operator = 'Equals'; expected = 'abc*' })) 'Literal equality failed.'
        Assert-That (-not (Test-Assertion 'ABC' ([pscustomobject]@{ operator = 'Equals'; expected = 'abc' }))) 'Comparison was not ordinal.'
        Assert-That (Test-Assertion 'abc.def' ([pscustomobject]@{ operator = 'Contains'; expected = '.' })) 'Literal contains failed.'
        Assert-That (Test-Assertion 'abc' ([pscustomobject]@{ operator = 'NotEquals'; expected = 'def' })) 'NotEquals failed.'
    }
    Test-Case 'Worker deadlines include startup and response grace' {
        $s = New-Step 'Delay' $null ([pscustomobject]@{ milliseconds = 20000 })
        Assert-That ((Get-StepLimit $s) -eq 30000) 'Delay deadline wrong.'
        Assert-That ((Get-StepLimit $document.steps[0]) -eq 20000) 'Action deadline wrong.'
    }
    Test-Case 'Result report excludes targets, argument values and variables' {
        $r = New-Result $document.steps[0] 0 'Passed' 'Completed' 2
        $report = New-Report $document @($r) $false 'Passed'
        $json = $report | ConvertTo-Json -Depth 80
        Assert-That ($report.results.Count -eq 1 -and $json -notmatch 'arguments|variables|automationId') 'Report leaked input data.'
    }
    $tempFolder = Join-Path ([IO.Path]::GetTempPath()) ('DTORadarTests-' + [guid]::NewGuid().ToString('N'))
    [void][IO.Directory]::CreateDirectory($tempFolder)
    try {
        Test-Case 'Atomic save creates and replaces valid UTF-8 JSON' {
            $path = Join-Path $tempFolder 'roundtrip.psrec'; Write-Json $path $document
            $d = Read-Json $path; Assert-Recording $d
            $d.name = 'Updated'; $d.description = 'Unicode ' + [char]0x00F1 + [char]0x4E2D; Write-Json $path $d
            $saved = Read-Json $path
            Assert-That ($saved.name -ceq 'Updated' -and $saved.description -ceq $d.description) 'Save or Unicode round trip failed.'
        }
        Test-Case 'Override variables win without mutating the recording' {
            $path = Join-Path $tempFolder 'variables.json'; Write-Json $path ([pscustomobject]@{ Customer = 'Override' })
            $v = Get-Variables $document $path
            Assert-That ($v.Customer -ceq 'Override' -and $document.variables.Customer -ceq 'Mira') 'Override behavior wrong.'
        }
        Test-Case 'Reject malformed JSON' {
            $path = Join-Path $tempFolder 'broken.json'; [IO.File]::WriteAllText($path,'{broken')
            Test-ExpectThrow { Read-Json $path }
        }
        Test-Case 'Worker response is preferred to process exit' {
            $path = Join-Path $tempFolder 'response.json'; Write-Json $path ([pscustomobject]@{ ok = $true; message = 'Completed'; data = $null; elapsedMs = 1 })
            $fake = [pscustomobject]@{ response = $path; process = [pscustomobject]@{ HasExited = $true; ExitCode = 0 } }
            Assert-That (Get-WorkerResult $fake).ok 'Valid response ignored.'
        }
        Test-Case 'Worker crash produces a failure result' {
            $fake = [pscustomobject]@{ response = (Join-Path $tempFolder 'missing.json'); process = [pscustomobject]@{ HasExited = $true; ExitCode = 12 }; clock = [pscustomobject]@{ ElapsedMilliseconds = 3 } }
            Assert-That (-not (Get-WorkerResult $fake).ok) 'Crash was not reported.'
        }
        Test-Case 'Worker timeout is explicit about unknown action outcome' {
            $fake = [pscustomobject]@{ response = (Join-Path $tempFolder 'missing.json'); process = [pscustomobject]@{ HasExited = $false }; clock = [pscustomobject]@{ ElapsedMilliseconds = 100 }; limitMs = 50 }
            $result = Get-WorkerResult $fake
            Assert-That (-not $result.ok -and $result.message -match 'unknown') 'Timeout lost uncertainty.'
        }
    } finally { Remove-Item -LiteralPath $tempFolder -Recurse -Force }

    # Mock only the UIA boundary. Exercise the actual wait/action control flow.
    $script:MockFindCalls = 0; $script:MockActions = 0; $script:MockNotReady = 0; $script:MockActionThrows = $false
    $script:MockElement = [pscustomobject]@{ Current = [pscustomobject]@{ IsEnabled = $true; IsPassword = $false; Name = 'Ready' } }
    $script:MockPattern = [pscustomobject]@{ Current = [pscustomobject]@{ IsReadOnly = $false; Value = 'Ready'; Minimum = 0; Maximum = 100 } }
    $script:MockPattern | Add-Member ScriptMethod SetValue { param($v) $script:MockActions++; if ($script:MockActionThrows) { throw 'Provider failed after submission.' } }
    function Find-Target($Target) { $script:MockFindCalls++; if ($script:MockFindCalls -le $script:MockNotReady) { throw 'Not ready.' }; return $script:MockElement }
    function Get-Pattern($Element, [string]$Name) { return $script:MockPattern }
    Test-Case 'Playback waits for readiness then submits the action once' {
        $script:MockFindCalls = 0; $script:MockActions = 0; $script:MockNotReady = 1
        $s = Resolve-StepData $document.steps[0] @{ Customer = 'Test' }; $s.timeoutMs = 1000
        Invoke-UiaStep $s $false
        Assert-That ($script:MockFindCalls -eq 2 -and $script:MockActions -eq 1) 'Readiness/action sequence wrong.'
    }
    Test-Case 'Dry run checks readiness without sending the action' {
        $script:MockNotReady = 0; $script:MockActions = 0
        Invoke-UiaStep (Resolve-StepData $document.steps[0] @{ Customer = 'Test' }) $true
        Assert-That ($script:MockActions -eq 0) 'Dry run submitted an action.'
    }
    Test-Case 'Provider action failure is never retried' {
        $script:MockActions = 0; $script:MockActionThrows = $true
        Test-ExpectThrow { Invoke-UiaStep (Resolve-StepData $document.steps[0] @{ Customer = 'Test' }) $false }
        Assert-That ($script:MockActions -eq 1) 'Failed action was repeated.'
        $script:MockActionThrows = $false
    }
    Test-Case 'Target timeout submits no action' {
        $script:MockFindCalls = 0; $script:MockActions = 0; $script:MockNotReady = 999
        $s = Resolve-StepData $document.steps[0] @{ Customer = 'Test' }; $s.timeoutMs = 100
        Test-ExpectThrow { Invoke-UiaStep $s $false }
        Assert-That ($script:MockActions -eq 0) 'Action sent without a ready target.'
        $script:MockNotReady = 0
    }
    Test-Case 'Password property read is rejected' {
        $script:MockElement.Current.IsPassword = $true
        Test-ExpectThrow { Get-UiaProperty $script:MockElement 'Value' }
        $script:MockElement.Current.IsPassword = $false
    }
    Write-Host ("`nTests: {0} passed, {1} failed. Live Windows UIA/GUI tests are separate." -f $script:TestPassed,$script:TestFailed)
    if ($script:TestFailed -gt 0) { exit 1 }
    exit 0
}

