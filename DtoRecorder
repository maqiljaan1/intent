function Start-UiPlayback([bool]$SelectedOnly) {
    try {
        $u = $script:Ui; Assert-Recording $u.Document
        $indices = @()
        if ($SelectedOnly) { $selected = Get-UiIndex; if ($selected -lt 0) { throw 'Select a step first.' }; $indices = @($selected) }
        else { for ($i = 0; $i -lt $u.Document.steps.Count; $i++) { $indices += $i } }
        Assert-That ($indices.Count -gt 0) 'Add or open a recording first.'
        $values = Get-Variables $u.Document $u.OverrideFile
        $resolved = @{}
        foreach ($i in $indices) { if ($u.Document.steps[$i].enabled) { $resolved[$i] = Resolve-StepData $u.Document.steps[$i] $values } }
        $u.Run = [pscustomobject]@{
            indices = $indices; position = 0; resolved = $resolved
            results = (New-Object Collections.Generic.List[object]); dryRun = [bool]$u.DryRun.Checked
            failed = $false; readyAt = [DateTime]::UtcNow
        }
        $u.LastReport = $null; $u.StepStatuses = @{}
        Set-UiBusy $true
        $label = 'Playback started.'; if ($u.Run.dryRun) { $label = 'Dry run started: targets are checked against the current screen; actions are not performed.' }
        Write-UiLog $label
    } catch { Show-UiError $_.Exception.Message }
}
function Finish-UiPlayback([string]$Status) {
    $u = $script:Ui; if ($null -eq $u.Run) { return }
    $u.LastReport = New-Report $u.Document $u.Run.results.ToArray() $u.Run.dryRun $Status
    $u.Run = $null; Set-UiBusy $false
    $u.Status.Text = 'Run ' + $Status + '. Use Export results to save the report.'
    Write-UiLog $u.Status.Text
}
function Stop-UiActivity {
    $u = $script:Ui
    $u.PickAt = $null
    if ($null -ne $u.Job) { Stop-WorkerJob $u.Job; $u.Job = $null }
    if ($null -ne $u.Run) {
        for ($p = $u.Run.position; $p -lt $u.Run.indices.Count; $p++) {
            $i = $u.Run.indices[$p]; $s = $u.Document.steps[$i]
            $status = 'Skipped'; $message = 'Run stopped.'
            if ($p -eq $u.Run.position -and $u.JobKind -eq 'Playback') { $status = 'Cancelled'; $message = 'Stopped; an already submitted action may have taken effect.' }
            $u.Run.results.Add((New-Result $s $i $status $message 0)); $u.StepStatuses[$s.id] = $status
        }
        Finish-UiPlayback 'Stopped'; Refresh-UiSteps
    }
    $u.JobKind = ''; Set-UiBusy $false
    $u.PendingStep = $null
    $u.Status.Text = 'Stopped. An already submitted action cannot be undone.'
    Write-UiLog $u.Status.Text
}
function Tick-Ui {
    $u = $script:Ui
    if ($null -ne $u.PickAt) {
        $remaining = ($u.PickAt - [DateTime]::UtcNow).TotalSeconds
        if ($remaining -gt 0) { $u.Status.Text = 'Point at the target control. Picking in ' + [Math]::Ceiling($remaining) + '...'; return }
        $u.PickAt = $null
        $point = [Windows.Forms.Cursor]::Position
        $u.Job = Start-WorkerJob ([pscustomobject]@{ kind = 'Pick'; x = $point.X; y = $point.Y; ownerProcessId = $PID }) 15000
        $u.JobKind = 'Pick'; $u.Status.Text = 'Inspecting the target...'
    }
    if ($null -ne $u.Job) {
        $result = Get-WorkerResult $u.Job; if ($null -eq $result) { return }
        Stop-WorkerJob $u.Job; $u.Job = $null
        $kind = $u.JobKind; $u.JobKind = ''
        if ($kind -eq 'Pick') {
            Set-UiBusy $false
            if ($result.ok) {
                $data = $result.data; $u.Target = $data.target
                $u.TargetInfo.Text = "Name: $($data.name)`r`nType: $($data.controlType)`r`nAutomationId: $($data.automationId)`r`nWindow: $($data.target.window.title)`r`nPatterns: $($data.patterns -join ', ')"
                $u.Status.Text = 'Target captured. Choose an action and Perform + record.'
                Write-UiLog 'Target captured.'
            } else { $u.Status.Text = 'Pick failed.'; Show-UiError $result.message }
            return
        }
        if ($kind -eq 'Record') {
            Set-UiBusy $false
            if ($result.ok) { Add-UiStep $u.PendingStep; $u.Status.Text = 'Action completed and step recorded.'; Write-UiLog $u.Status.Text }
            else { $u.Status.Text = 'Action failed; no step recorded.'; Show-UiError $result.message }
            $u.PendingStep = $null; return
        }
        if ($kind -eq 'Playback') {
            $i = $u.Run.indices[$u.Run.position]; $step = $u.Document.steps[$i]
            $status = 'Passed'; if ($u.Run.dryRun) { $status = 'Validated' }
            if (-not $result.ok) { $status = 'Failed'; $u.Run.failed = $true }
            $u.Run.results.Add((New-Result $step $i $status $result.message $result.elapsedMs))
            $u.StepStatuses[$step.id] = $status
            Write-UiLog ("Step {0}: {1}. {2}" -f ($i + 1), $status, $result.message)
            $u.Run.position++
            Refresh-UiSteps $i
            if (-not $result.ok -and $step.onError -eq 'Stop') {
                for ($p = $u.Run.position; $p -lt $u.Run.indices.Count; $p++) {
                    $j = $u.Run.indices[$p]; $other = $u.Document.steps[$j]
                    $u.Run.results.Add((New-Result $other $j 'Skipped' 'Earlier step stopped the run.' 0)); $u.StepStatuses[$other.id] = 'Skipped'
                }
                Finish-UiPlayback 'Failed'; Refresh-UiSteps $i; return
            }
            $u.Run.readyAt = [DateTime]::UtcNow.AddMilliseconds($u.Document.settings.intervalMs)
        }
    }
    if ($null -ne $u.Run -and [DateTime]::UtcNow -ge $u.Run.readyAt) {
        while ($u.Run.position -lt $u.Run.indices.Count) {
            $i = $u.Run.indices[$u.Run.position]; $step = $u.Document.steps[$i]
            if ($step.enabled) { break }
            $u.Run.results.Add((New-Result $step $i 'Skipped' 'Disabled' 0)); $u.StepStatuses[$step.id] = 'Skipped'; $u.Run.position++
        }
        if ($u.Run.position -ge $u.Run.indices.Count) {
            $status = 'Passed'; if ($u.Run.dryRun) { $status = 'Validated' }; if ($u.Run.failed) { $status = 'Failed' }
            Finish-UiPlayback $status; Refresh-UiSteps; return
        }
        $i = $u.Run.indices[$u.Run.position]; $step = $u.Document.steps[$i]
        $u.Job = Start-WorkerJob ([pscustomobject]@{ kind = 'Step'; step = $u.Run.resolved[$i]; dryRun = $u.Run.dryRun }) (Get-StepLimit $step)
        $u.JobKind = 'Playback'; $u.StepStatuses[$step.id] = 'Running'; Refresh-UiSteps $i
        $u.Status.Text = 'Running step ' + ($i + 1) + ': ' + $step.label
    }
}
