    $script:Ui.Action.SelectedItem = $s.action
    $script:Ui.Arguments.Text = $s.arguments | ConvertTo-Json -Depth 80
    $script:Ui.StepLabel.Text = $s.label; $script:Ui.Timeout.Value = $s.timeoutMs
