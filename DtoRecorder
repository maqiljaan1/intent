#requires -Version 5.1
<#
DTORadar Recorder 1.0
All application code, GUI, worker, validation and tests are PowerShell.
Uses only Windows/.NET libraries. No embedded C#, modules or downloads.
Record means: pick a UIA control, perform an action, append it after success.
It does not passively intercept mouse clicks or keyboard input.
#>
[CmdletBinding()]
param(
    [string]$Open,
    [string]$Play,
    [string]$VariablesFile,
    [string]$ResultPath,
    [switch]$DryRun,
    [switch]$SelfTest,
    [switch]$Demo,
    [switch]$Worker,
    [string]$RequestPath,
    [string]$ResponsePath
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'
$script:EntryPath = $PSCommandPath
$script:Actions = @('Invoke','SetValue','SetRange','Toggle','Select','AddToSelection',
    'RemoveFromSelection','Expand','Collapse','Focus','Scroll','SetScrollPercent',
    'ScrollIntoView','WaitFor','AssertProperty','Delay')
$script:Properties = @('Name','AutomationId','ClassName','ControlType','IsEnabled',
    'IsOffscreen','HasKeyboardFocus','Value','ToggleState','IsSelected',
    'ExpandCollapseState','RangeValue')

function Assert-That($Condition, [string]$Message) {
    if (-not $Condition) { throw $Message }
}
function Test-Field($Object, [string]$Name) {
    return ($null -ne $Object -and $null -ne $Object.PSObject.Properties[$Name])
}
function Assert-Object($Object, [string]$Name) {
    Assert-That ($null -ne $Object -and $Object -is [pscustomobject]) "$Name must be a JSON object."
}
function Assert-Fields($Object, [string[]]$Required, [string[]]$Allowed, [string]$Name) {
    Assert-Object $Object $Name
    foreach ($key in $Required) { Assert-That (Test-Field $Object $key) "$Name is missing '$key'." }
    foreach ($prop in $Object.PSObject.Properties) {
        Assert-That ($Allowed -ccontains $prop.Name) "$Name contains unknown field '$($prop.Name)'."
    }
}
function Assert-String($Value, [string]$Name, [int]$Maximum = 65536) {
    Assert-That ($Value -is [string] -and $Value.Length -le $Maximum) "$Name must be a string of at most $Maximum characters."
}
function Assert-Integer($Value, [long]$Minimum, [long]$Maximum, [string]$Name) {
    Assert-That (($Value -is [int] -or $Value -is [long]) -and
        $Value -ge $Minimum -and $Value -le $Maximum) "$Name must be an integer from $Minimum to $Maximum."
}
function Test-Template([string]$Value) { return ($Value -match '\$\{[A-Za-z_][A-Za-z0-9_]*\}') }
function Assert-Number($Value, [double]$Minimum, [double]$Maximum, [string]$Name) {
    if ($Value -is [string] -and (Test-Template $Value)) { return }
    $number = 0.0
    $parsed = [double]::TryParse([string]$Value, [Globalization.NumberStyles]::Float,
        [Globalization.CultureInfo]::InvariantCulture, [ref]$number)
    Assert-That ($parsed -and -not [double]::IsNaN($number) -and
        -not [double]::IsInfinity($number) -and $number -ge $Minimum -and $number -le $Maximum) "$Name is outside its numeric range."
}
function Convert-Number($Value) {
    return [double]::Parse([string]$Value, [Globalization.CultureInfo]::InvariantCulture)
}
function Copy-Data($Value) { return ($Value | ConvertTo-Json -Depth 80 -Compress | ConvertFrom-Json) }
function Read-Json([string]$Path) {
    $file = Get-Item -LiteralPath $Path
    Assert-That (-not $file.PSIsContainer -and $file.Length -le 10485760) 'JSON files must be no larger than 10 MiB.'
    return ([IO.File]::ReadAllText($file.FullName) | ConvertFrom-Json)
}
function Write-Json([string]$Path, $Value) {
    $full = [IO.Path]::GetFullPath($Path)
    $parent = [IO.Path]::GetDirectoryName($full)
    [void][IO.Directory]::CreateDirectory($parent)
    $temp = Join-Path $parent ('.' + [IO.Path]::GetFileName($full) + '.' + [guid]::NewGuid().ToString('N') + '.tmp')
    try {
        [IO.File]::WriteAllText($temp, ($Value | ConvertTo-Json -Depth 80), (New-Object Text.UTF8Encoding($false)))
        if ([IO.File]::Exists($full)) {
            # Atomic replacement: an interrupted save leaves the previous file intact.
            [IO.File]::Replace($temp, $full, [System.Management.Automation.Language.NullString]::Value)
        } else { [IO.File]::Move($temp, $full) }
    } finally { if ([IO.File]::Exists($temp)) { [IO.File]::Delete($temp) } }
}
function New-Recording {
    return [pscustomobject][ordered]@{
        format = 'DTORadar.Recording'; schemaVersion = 1; name = 'Untitled recording'
        description = ''; variables = [pscustomobject]@{}
        settings = [pscustomobject]@{ intervalMs = 250 }
        steps = @()
    }
}
function New-Step([string]$Action, $Target = $null, $Arguments = $null) {
    if ($null -eq $Arguments) { $Arguments = [pscustomobject]@{} }
    return [pscustomobject][ordered]@{
        id = [guid]::NewGuid().ToString(); label = $Action; enabled = $true
        action = $Action; target = $Target; arguments = $Arguments
        timeoutMs = 10000; onError = 'Stop'
    }
}
function Assert-Target($Target) {
    Assert-Fields $Target @('window','path') @('window','path') 'target'
    $w = $Target.window
    Assert-Fields $w @('processName','className','title','titleMatch') @('processName','className','title','titleMatch') 'target.window'
    foreach ($key in @('processName','className','title')) { Assert-String $w.$key "window.$key" 1024 }
    Assert-That ($w.processName.Length -gt 0) 'window.processName cannot be empty.'
    Assert-That (@('Exact','Ignore') -ccontains $w.titleMatch) 'titleMatch must be Exact or Ignore.'
    Assert-That ($Target.path -is [array] -and $Target.path.Count -le 64) 'target.path must be an array with at most 64 segments.'
    foreach ($seg in $Target.path) {
        $fields = @('automationId','name','className','controlType','useName','index','matchCount')
        Assert-Fields $seg $fields $fields 'path segment'
        foreach ($key in @('automationId','name','className')) { Assert-String $seg.$key "segment.$key" 4096 }
        Assert-Integer $seg.controlType 50000 50100 'controlType'
        Assert-That ($seg.useName -is [bool]) 'useName must be true or false.'
        Assert-Integer $seg.matchCount 1 5000 'matchCount'
        Assert-Integer $seg.index 0 ($seg.matchCount - 1) 'index'
    }
}
function Assert-Step($Step) {
    $fields = @('id','label','enabled','action','target','arguments','timeoutMs','onError')
    Assert-Fields $Step $fields $fields 'step'
    Assert-String $Step.id 'id' 80
    Assert-That ($Step.id.Length -gt 0) 'Step id cannot be empty.'
    Assert-String $Step.label 'label' 256
    Assert-That ($Step.enabled -is [bool]) 'enabled must be true or false.'
    Assert-That ($script:Actions -ccontains $Step.action) 'Unknown step action.'
    Assert-Integer $Step.timeoutMs 100 300000 'timeoutMs'
    Assert-That (@('Stop','Continue') -ccontains $Step.onError) 'onError must be Stop or Continue.'
    if ($Step.action -eq 'Delay') { Assert-That ($null -eq $Step.target) 'Delay must have a null target.' }
    else { Assert-Target $Step.target }
    $a = $Step.arguments
    switch -CaseSensitive ($Step.action) {
        'SetValue' { Assert-Fields $a @('value') @('value') 'arguments'; Assert-String $a.value 'value' }
        'SetRange' { Assert-Fields $a @('value') @('value') 'arguments'; Assert-Number $a.value ([double]::MinValue) ([double]::MaxValue) 'value' }
        'Delay' { Assert-Fields $a @('milliseconds') @('milliseconds') 'arguments'; Assert-Integer $a.milliseconds 0 300000 'milliseconds' }
        'Scroll' {
            Assert-Fields $a @('horizontal','vertical') @('horizontal','vertical') 'arguments'
            $amounts = @('NoAmount','SmallIncrement','LargeIncrement','SmallDecrement','LargeDecrement')
            Assert-That (($amounts -ccontains $a.horizontal) -and ($amounts -ccontains $a.vertical)) 'Invalid Scroll amount.'
        }
        'SetScrollPercent' {
            Assert-Fields $a @('horizontal','vertical') @('horizontal','vertical') 'arguments'
            foreach ($key in @('horizontal','vertical')) {
                Assert-Number $a.$key -1 100 $key
                if (-not (Test-Template ([string]$a.$key))) {
                    $n = Convert-Number $a.$key
                    Assert-That ($n -eq -1 -or $n -ge 0) 'Scroll percent must be -1 or 0 through 100.'
                }
            }
        }
        'AssertProperty' {
            Assert-Fields $a @('property','operator','expected') @('property','operator','expected') 'arguments'
            Assert-That ($script:Properties -ccontains $a.property) 'Unsupported assertion property.'
            Assert-That (@('Equals','Contains','NotEquals') -ccontains $a.operator) 'Invalid assertion operator.'
            Assert-String $a.expected 'expected'
        }
        default { Assert-Fields $a @() @() 'arguments' }
    }
}
function Assert-Variables($Variables) {
    Assert-Object $Variables 'variables'
    foreach ($p in $Variables.PSObject.Properties) {
        Assert-That ($p.Name -cmatch '^[A-Za-z_][A-Za-z0-9_]*$') 'Variable names must be letters, digits and underscores; start with a letter or underscore.'
        Assert-String $p.Value 'variable value'
    }
}
function Assert-Recording($Document) {
    $fields = @('format','schemaVersion','name','description','variables','settings','steps')
    Assert-Fields $Document $fields $fields 'recording'
    Assert-That ($Document.format -ceq 'DTORadar.Recording') 'This is not a DTORadar .psrec recording.'
    Assert-Integer $Document.schemaVersion 1 1 'schemaVersion'
    Assert-String $Document.name 'name' 256
    Assert-String $Document.description 'description'
    Assert-Variables $Document.variables
    Assert-Fields $Document.settings @('intervalMs') @('intervalMs') 'settings'
    Assert-Integer $Document.settings.intervalMs 0 60000 'intervalMs'
    Assert-That ($Document.steps -is [array] -and $Document.steps.Count -le 10000) 'steps must be an array with at most 10000 entries.'
    $ids = @{}
    foreach ($step in $Document.steps) {
        Assert-Step $step
        Assert-That (-not $ids.ContainsKey($step.id)) 'Duplicate step id.'
        $ids[$step.id] = $true
    }
}
function Get-Variables($Document, [string]$OverrideFile) {
    $values = @{}
    foreach ($p in $Document.variables.PSObject.Properties) { $values[$p.Name] = $p.Value }
    if ($OverrideFile) {
        $overrides = Read-Json $OverrideFile
        Assert-Variables $overrides
        foreach ($p in $overrides.PSObject.Properties) { $values[$p.Name] = $p.Value }
    }
    return $values
}
function Expand-Data($Value, [hashtable]$Values) {
    if ($null -eq $Value) { return $null }
    if ($Value -is [string]) {
        $evaluator = [Text.RegularExpressions.MatchEvaluator]{
            param($match)
            $key = $match.Groups[1].Value
            if (-not $Values.ContainsKey($key)) { throw "Variable '$key' is not defined." }
            return [string]$Values[$key]
        }.GetNewClosure()
        return [regex]::Replace($Value, '\$\{([A-Za-z_][A-Za-z0-9_]*)\}', $evaluator)
    }
    if ($Value -is [array]) {
        $items = @(); foreach ($item in $Value) { $items += ,(Expand-Data $item $Values) }
        return ,$items
    }
    if ($Value -is [pscustomobject]) {
        $obj = [ordered]@{}
        foreach ($p in $Value.PSObject.Properties) { $obj[$p.Name] = Expand-Data $p.Value $Values }
        return [pscustomobject]$obj
    }
    return $Value
}
function Resolve-StepData($Step, [hashtable]$Values) {
    # Never expand identity, action or control-flow fields. Variables are literal data.
    $copy = Copy-Data $Step
    $copy.target = Expand-Data $Step.target $Values
    $copy.arguments = Expand-Data $Step.arguments $Values
    Assert-Step $copy
    # After expansion, numeric values must actually parse, even if the replacement
    # text itself contains a literal ${...} sequence (substitution is one pass).
    if ($copy.action -eq 'SetRange') { [void](Convert-Number $copy.arguments.value) }
    if ($copy.action -eq 'SetScrollPercent') {
        [void](Convert-Number $copy.arguments.horizontal)
        [void](Convert-Number $copy.arguments.vertical)
    }
    return $copy
}

# UIA is loaded only in the separate MTA worker process, never on the GUI thread.
function Initialize-Uia {
    Add-Type -AssemblyName UIAutomationClient
    Add-Type -AssemblyName UIAutomationTypes
    Add-Type -AssemblyName WindowsBase
    Add-Type -AssemblyName System.Windows.Forms
}
function Test-Segment($Element, $Segment) {
    $c = $Element.Current
    if ($c.ControlType.Id -ne $Segment.controlType) { return $false }
    if ($Segment.automationId -and $c.AutomationId -cne $Segment.automationId) { return $false }
    if ($Segment.className -and $c.ClassName -cne $Segment.className) { return $false }
    if ($Segment.useName -and $c.Name -cne $Segment.name) { return $false }
    return $true
}
function Get-ControlChildren($Parent) {
    $items = New-Object Collections.Generic.List[object]
    $walker = [Windows.Automation.TreeWalker]::ControlViewWalker
    $child = $walker.GetFirstChild($Parent)
    while ($null -ne $child) {
        if ($items.Count -ge 5000) { throw 'A control has more than 5000 children; use a narrower target.' }
        $items.Add($child)
        $child = $walker.GetNextSibling($child)
    }
    return ,($items.ToArray())
}
function Get-ElementKey($Element) { return ($Element.GetRuntimeId() -join ':') }
function Get-Locator($Element, [int]$OwnerProcessId) {
    $walker = [Windows.Automation.TreeWalker]::ControlViewWalker
    $element = $walker.Normalize($Element)
    Assert-That ($null -ne $element) 'No control was found.'
    $desktop = [Windows.Automation.AutomationElement]::RootElement
    $desktopKey = Get-ElementKey $desktop
    $segments = New-Object Collections.Generic.List[object]
    $node = $element
    for ($depth = 0; $depth -le 64; $depth++) {
        $parent = $walker.GetParent($node)
        Assert-That ($null -ne $parent) 'Pick a control in an application window, not the desktop.'
        if ((Get-ElementKey $parent) -eq $desktopKey) { break }
        Assert-That ($depth -lt 64) 'Control path exceeds 64 levels.'
        $c = $node.Current
        $segment = [pscustomobject][ordered]@{
            automationId = [string]$c.AutomationId; name = [string]$c.Name
            className = [string]$c.ClassName; controlType = [int]$c.ControlType.Id
            useName = [bool]([string]::IsNullOrEmpty($c.AutomationId) -and
                $c.ControlType.Id -ne 50004 -and $c.ControlType.Id -ne 50030)
            index = 0; matchCount = 1
        }
        # Edit/Document names can contain current text. Never store their contents as locators.
        if ($c.ControlType.Id -eq 50004 -or $c.ControlType.Id -eq 50030 -or $c.IsPassword) {
            $segment.name = ''; $segment.useName = $false
        }
        $candidateMatches = @(Get-ControlChildren $parent | ForEach-Object { $_ } | Where-Object { Test-Segment $_ $segment })
        $key = Get-ElementKey $node
        $found = -1
        for ($i = 0; $i -lt $candidateMatches.Count; $i++) { if ((Get-ElementKey $candidateMatches[$i]) -eq $key) { $found = $i; break } }
        Assert-That ($found -ge 0) 'The control tree changed while picking. Pick it again.'
        $segment.index = $found; $segment.matchCount = $candidateMatches.Count
        $segments.Insert(0, $segment)
        $node = $parent
    }
    $w = $node.Current
    Assert-That ($w.ProcessId -ne $OwnerProcessId -and $w.ProcessId -ne $PID) 'Pick a control outside the recorder.'
    Assert-That (@('Progman','WorkerW') -notcontains $w.ClassName) 'The desktop is not a supported target.'
    $processName = (Get-Process -Id $w.ProcessId).ProcessName
    return [pscustomobject][ordered]@{
        window = [pscustomobject][ordered]@{
            processName = $processName; className = [string]$w.ClassName
            title = [string]$w.Name; titleMatch = 'Exact'
        }
        path = @($segments.ToArray())
    }
}
function Find-Target($Target) {
    $windows = New-Object Collections.Generic.List[object]
    $w = $Target.window
    $desktop = [Windows.Automation.AutomationElement]::RootElement
    foreach ($candidate in (Get-ControlChildren $desktop)) {
        try {
            $c = $candidate.Current
            if ($w.className -and $c.ClassName -cne $w.className) { continue }
            if ($w.titleMatch -eq 'Exact' -and $c.Name -cne $w.title) { continue }
            if ((Get-Process -Id $c.ProcessId -ErrorAction Stop).ProcessName -ine $w.processName) { continue }
            $windows.Add($candidate)
        } catch { continue }
    }
    if ($windows.Count -gt 1) { throw 'Ambiguous window: use an exact title or close duplicate windows.' }
    if ($windows.Count -eq 0) { throw 'Target window is not available.' }
    $node = $windows[0]
    foreach ($seg in $Target.path) {
        $candidateMatches = @(Get-ControlChildren $node | ForEach-Object { $_ } | Where-Object { Test-Segment $_ $seg })
        if ($candidateMatches.Count -ne $seg.matchCount) { throw 'Control path changed or is unavailable; recapture the target.' }
        $node = $candidateMatches[$seg.index]
    }
    return $node
}
function Get-Pattern($Element, [string]$Name) {
    $type = [type]("System.Windows.Automation.${Name}Pattern, UIAutomationClient")
    $patternId = $type.GetField('Pattern').GetValue($null)
    $pattern = $null
    if (-not $Element.TryGetCurrentPattern($patternId, [ref]$pattern)) { throw "This control does not expose the $Name pattern." }
    return $pattern
}
function Get-UiaProperty($Element, [string]$Property) {
    $c = $Element.Current
    switch -CaseSensitive ($Property) {
        'Value' {
            if ($c.IsPassword) { throw 'Password values cannot be read or asserted.' }
            return [string](Get-Pattern $Element 'Value').Current.Value
        }
        'ToggleState' { return [string](Get-Pattern $Element 'Toggle').Current.ToggleState }
        'IsSelected' { return [string](Get-Pattern $Element 'SelectionItem').Current.IsSelected }
        'ExpandCollapseState' { return [string](Get-Pattern $Element 'ExpandCollapse').Current.ExpandCollapseState }
        'RangeValue' { return (Get-Pattern $Element 'RangeValue').Current.Value.ToString([Globalization.CultureInfo]::InvariantCulture) }
        'ControlType' { return [string]$c.ControlType.ProgrammaticName }
        default { return [string]$c.$Property }
    }
}
function Test-Assertion([string]$Actual, $Arguments) {
    switch -CaseSensitive ($Arguments.operator) {
        'Equals' { return [string]::Equals($Actual, $Arguments.expected, [StringComparison]::Ordinal) }
        'NotEquals' { return -not [string]::Equals($Actual, $Arguments.expected, [StringComparison]::Ordinal) }
        'Contains' { return $Actual.IndexOf($Arguments.expected, [StringComparison]::Ordinal) -ge 0 }
    }
    return $false
}
function Get-RequiredPattern([string]$Action) {
    switch ($Action) {
        'Invoke' { 'Invoke' }; 'SetValue' { 'Value' }; 'SetRange' { 'RangeValue' }
        'Toggle' { 'Toggle' }; 'Select' { 'SelectionItem' }; 'AddToSelection' { 'SelectionItem' }
        'RemoveFromSelection' { 'SelectionItem' }; 'Expand' { 'ExpandCollapse' }; 'Collapse' { 'ExpandCollapse' }
        'Scroll' { 'Scroll' }; 'SetScrollPercent' { 'Scroll' }; 'ScrollIntoView' { 'ScrollItem' }
        default { '' }
    }
}
function Assert-ActionReady($Element, $Step) {
    $patternName = Get-RequiredPattern $Step.action
    if ($patternName) {
        $p = Get-Pattern $Element $patternName
        if ($Step.action -eq 'SetValue' -or $Step.action -eq 'SetRange') {
            Assert-That (-not $p.Current.IsReadOnly) 'The target is read-only.'
        }
        if ($Step.action -eq 'SetRange') {
            $n = Convert-Number $Step.arguments.value
            Assert-That ($n -ge $p.Current.Minimum -and $n -le $p.Current.Maximum) 'The value is outside the control range.'
        }
    }
    if (@('WaitFor','AssertProperty') -notcontains $Step.action) {
        Assert-That $Element.Current.IsEnabled 'The target is disabled.'
    }
}
function Invoke-UiaStep($Step, [bool]$ValidateOnly) {
    Assert-Step $Step
    if ($Step.action -eq 'Delay') {
        if (-not $ValidateOnly) { Start-Sleep -Milliseconds $Step.arguments.milliseconds }
        return
    }
    $clock = [Diagnostics.Stopwatch]::StartNew()
    $lastError = 'Target is not ready.'
    do {
        try {
            $element = Find-Target $Step.target
            Assert-ActionReady $element $Step
            if ($Step.action -eq 'AssertProperty') {
                $actual = Get-UiaProperty $element $Step.arguments.property
                if (-not (Test-Assertion $actual $Step.arguments)) { throw 'Assertion did not match.' }
            }
            $ready = $true
        } catch { $ready = $false; $lastError = $_.Exception.Message }
        if ($ready) { break }
        if ($clock.ElapsedMilliseconds -ge $Step.timeoutMs) { throw "Target wait timed out. $lastError" }
        Start-Sleep -Milliseconds 150
    } while ($true)
    if ($ValidateOnly) { return }
    $a = $Step.arguments
    # Deliberately outside the retry loop: a mutating action is never automatically replayed.
    switch -CaseSensitive ($Step.action) {
        'Invoke' { (Get-Pattern $element 'Invoke').Invoke() }
        'SetValue' { (Get-Pattern $element 'Value').SetValue([string]$a.value) }
        'SetRange' { (Get-Pattern $element 'RangeValue').SetValue((Convert-Number $a.value)) }
        'Toggle' { (Get-Pattern $element 'Toggle').Toggle() }
        'Select' { (Get-Pattern $element 'SelectionItem').Select() }
        'AddToSelection' { (Get-Pattern $element 'SelectionItem').AddToSelection() }
        'RemoveFromSelection' { (Get-Pattern $element 'SelectionItem').RemoveFromSelection() }
        'Expand' { (Get-Pattern $element 'ExpandCollapse').Expand() }
        'Collapse' { (Get-Pattern $element 'ExpandCollapse').Collapse() }
        'Focus' { $element.SetFocus() }
        'Scroll' { (Get-Pattern $element 'Scroll').Scroll([Windows.Automation.ScrollAmount]$a.horizontal, [Windows.Automation.ScrollAmount]$a.vertical) }
        'SetScrollPercent' { (Get-Pattern $element 'Scroll').SetScrollPercent((Convert-Number $a.horizontal),(Convert-Number $a.vertical)) }
        'ScrollIntoView' { (Get-Pattern $element 'ScrollItem').ScrollIntoView() }
        'WaitFor' { }
        'AssertProperty' { }
    }
}
function Invoke-Worker {
    $outcome = [pscustomobject]@{ ok = $false; message = ''; data = $null; elapsedMs = 0 }
    $clock = [Diagnostics.Stopwatch]::StartNew()
    try {
        Initialize-Uia
        $request = Read-Json $RequestPath
        switch -CaseSensitive ($request.kind) {
            'Pick' {
                $point = New-Object Windows.Point([double]$request.x, [double]$request.y)
                $element = [Windows.Automation.AutomationElement]::FromPoint($point)
                $element = [Windows.Automation.TreeWalker]::ControlViewWalker.Normalize($element)
                $target = Get-Locator $element $request.ownerProcessId
                Assert-Target $target
                $c = $element.Current
                $name = [string]$c.Name
                if ($c.IsPassword -or $c.ControlType.Id -eq 50004 -or $c.ControlType.Id -eq 50030) { $name = '(text omitted)' }
                $outcome.data = [pscustomobject]@{
                    target = $target; name = $name; controlType = $c.ControlType.ProgrammaticName
                    automationId = $c.AutomationId; isPassword = $c.IsPassword
                    patterns = @($element.GetSupportedPatterns() | ForEach-Object { $_.ProgrammaticName })
                }
            }
            'Step' { Invoke-UiaStep $request.step ([bool]$request.dryRun) }
            default { throw 'Unknown worker request.' }
        }
        $outcome.ok = $true; $outcome.message = 'Completed'
    } catch { $outcome.message = $_.Exception.Message }
    $outcome.elapsedMs = $clock.ElapsedMilliseconds
    Write-Json $ResponsePath $outcome
}

# A disposable PowerShell process bounds provider hangs and isolates UIA COM state.
function Start-WorkerJob($Request, [int]$LimitMs) {
    $base = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'DTORadarRecorder\Sessions'
    $folder = Join-Path $base ([guid]::NewGuid().ToString('N'))
    [void][IO.Directory]::CreateDirectory($folder)
    $requestFile = Join-Path $folder 'request.json'
    $responseFile = Join-Path $folder 'response.json'
    Write-Json $requestFile $Request
    $info = New-Object Diagnostics.ProcessStartInfo
    $info.FileName = Join-Path $PSHOME 'powershell.exe'
    $info.Arguments = '-NoLogo -NoProfile -NonInteractive -Mta -File "{0}" -Worker -RequestPath "{1}" -ResponsePath "{2}"' -f $script:EntryPath, $requestFile, $responseFile
    $info.UseShellExecute = $false; $info.CreateNoWindow = $true
    try { $process = [Diagnostics.Process]::Start($info) }
    catch { Remove-Item -LiteralPath $folder -Recurse -Force -ErrorAction SilentlyContinue; throw }
    return [pscustomobject]@{
        process = $process; folder = $folder; response = $responseFile
        clock = [Diagnostics.Stopwatch]::StartNew(); limitMs = $LimitMs
    }
}
function Stop-WorkerJob($Job) {
    if ($null -eq $Job) { return }
    try {
        if (-not $Job.process.HasExited) { $Job.process.Kill(); [void]$Job.process.WaitForExit(500) }
    } catch { }
    finally {
        $Job.process.Dispose()
        Remove-Item -LiteralPath $Job.folder -Recurse -Force -ErrorAction SilentlyContinue
    }
}
function Get-WorkerResult($Job) {
    if (Test-Path -LiteralPath $Job.response) {
        return Read-Json $Job.response
    }
    if ($Job.process.HasExited) {
        return [pscustomobject]@{ ok = $false; message = "Worker exited without a result (exit $($Job.process.ExitCode)). Check PowerShell policy and UIA availability."; data = $null; elapsedMs = $Job.clock.ElapsedMilliseconds }
    }
    if ($Job.clock.ElapsedMilliseconds -gt $Job.limitMs) {
        return [pscustomobject]@{ ok = $false; message = 'Worker time limit exceeded. If an action was already submitted, its outcome is unknown; inspect the target before retrying.'; data = $null; elapsedMs = $Job.clock.ElapsedMilliseconds }
    }
    return $null
}
function Get-StepLimit($Step) {
    if ($Step.action -eq 'Delay') { return [int]$Step.arguments.milliseconds + 10000 }
    return [int]$Step.timeoutMs + 10000
}
function New-Result($Step, [int]$Index, [string]$Status, [string]$Message, [long]$ElapsedMs) {
    return [pscustomobject][ordered]@{
        index = $Index + 1; stepId = $Step.id; label = $Step.label; action = $Step.action
        status = $Status; message = $Message; elapsedMs = $ElapsedMs
        timestampUtc = [DateTime]::UtcNow.ToString('o')
    }
}
function New-Report($Document, $Results, [bool]$ValidationOnly, [string]$Status) {
    return [pscustomobject][ordered]@{
        format = 'DTORadar.Run'; schemaVersion = 1; recordingName = $Document.name
        dryRun = $ValidationOnly; status = $Status; endedUtc = [DateTime]::UtcNow.ToString('o')
        results = @($Results)
    }
}
function Invoke-ConsolePlayback {
    $document = Read-Json $Play; Assert-Recording $document
    $values = Get-Variables $document $VariablesFile
    # Resolve ALL enabled steps before the first mutation, so missing variables fail early.
    $resolved = @{}
    for ($i = 0; $i -lt $document.steps.Count; $i++) {
        if ($document.steps[$i].enabled) { $resolved[$i] = Resolve-StepData $document.steps[$i] $values }
    }
    $results = New-Object Collections.Generic.List[object]
    $job = $null; $failed = $false; $halt = $false
    try {
        for ($i = 0; $i -lt $document.steps.Count; $i++) {
            $step = $document.steps[$i]
            if (-not $step.enabled -or $halt) {
                $reason = 'Disabled'; if ($halt) { $reason = 'Earlier step stopped the run' }
                $results.Add((New-Result $step $i 'Skipped' $reason 0)); continue
            }
            $job = Start-WorkerJob ([pscustomobject]@{ kind = 'Step'; step = $resolved[$i]; dryRun = [bool]$DryRun }) (Get-StepLimit $step)
            do { Start-Sleep -Milliseconds 100; $response = Get-WorkerResult $job } while ($null -eq $response)
            Stop-WorkerJob $job; $job = $null
            $status = 'Passed'; if ($DryRun) { $status = 'Validated' }
            if (-not $response.ok) { $status = 'Failed'; $failed = $true; $halt = $step.onError -eq 'Stop' }
            $results.Add((New-Result $step $i $status $response.message $response.elapsedMs))
            Write-Host ('{0,3}. {1,-10} {2}' -f ($i + 1), $status, $step.label)
            if (-not $halt -and $document.settings.intervalMs -gt 0) { Start-Sleep -Milliseconds $document.settings.intervalMs }
        }
    } finally { Stop-WorkerJob $job }
    $overall = 'Passed'; if ($DryRun) { $overall = 'Validated' }; if ($failed) { $overall = 'Failed' }
    $report = New-Report $document $results.ToArray() ([bool]$DryRun) $overall
    $destination = $ResultPath
    if (-not $destination) { $destination = [IO.Path]::ChangeExtension([IO.Path]::GetFullPath($Play), ([DateTime]::Now.ToString('yyyyMMdd-HHmmss-fff') + '.psrun.json')) }
    Write-Json $destination $report
    Write-Host "Results: $destination"
    if ($failed) { exit 1 }
    exit 0
}

