function Change-UiStep([string]$Operation) {
    $u = $script:Ui; $i = Get-UiIndex; if ($i -lt 0) { return }
    $steps = New-Object Collections.Generic.List[object]
    foreach ($s in $u.Document.steps) { $steps.Add($s) }
    switch ($Operation) {
        'Up' { if ($i -eq 0) { return }; $s = $steps[$i]; $steps.RemoveAt($i); $i--; $steps.Insert($i,$s) }
        'Down' { if ($i -eq $steps.Count - 1) { return }; $s = $steps[$i]; $steps.RemoveAt($i); $i++; $steps.Insert($i,$s) }
        'Duplicate' { $s = Copy-Data $steps[$i]; $s.id = [guid]::NewGuid().ToString(); $i++; $steps.Insert($i,$s) }
        'Toggle' { $steps[$i].enabled = -not $steps[$i].enabled }
        'Delete' { $steps.RemoveAt($i); $i = [Math]::Min($i,$steps.Count - 1) }
    }
    $u.Document.steps = @($steps.ToArray()); Set-UiDirty; Refresh-UiSteps $i
}
